# Copie para .env (não commitado) e preencha com valores reais.
# Em produção (Vercel), as mesmas chaves vão em Project Settings → Environment Variables.

# Conta de serviço do Google (Google Cloud Console → IAM → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=algo@seu-projeto.iam.gserviceaccount.com
# Cole a chave privada do JSON da conta de serviço, com as quebras de linha
# como "\n" literal (é assim que normalmente vem colando de um .env de exemplo).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets)
GOOGLE_SHEET_ID=
